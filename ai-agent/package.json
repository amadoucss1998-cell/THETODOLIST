{
  "name": "ai-web-research-agent",
  "version": "1.0.0",
  "description": "AI agent that researches latest AI news, generates a PDF, and emails it",
  "type": "module",
  "main": "dist/agent.js",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/agent.js",
    "dev": "npx tsx --env-file=.env agent.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.51.0",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.15.2"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.9",
    "@types/node": "^22.10.10",
    "tsx": "^4.19.2",
    "typescript": "^5.2.2"
  }
}
